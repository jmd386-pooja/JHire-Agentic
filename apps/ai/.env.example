# ==============================
# AI Project – .env.example
# (Copy this file to `.env` and fill in the values.)
# Do NOT commit your real `.env`.
# ==============================

# -------- Core / App --------
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=changeme_nextauth_secret
NEXT_PUBLIC_SERVER_URL=http://localhost:8000
AGENT_BASE_URL=http://localhost:8000

# -------- Database --------
# Preferred: PostgreSQL, required by mcp_tools.DatabaseManager
DATABASE_URL=postgresql://user:password@localhost:5432/your_db_name
# Optional legacy fallback (not recommended / may be ignored by code)
DB_PATH=./jhire_resumes.db

# -------- LLM / API Keys --------
# Google Gemini
GOOGLE_API_KEY=your_google_api_key
GEMINI_API_KEY=your_gemini_api_key   # (alias if used separately)

# OpenAI
OPENAI_API_KEY=your_openai_api_key

# Mistral
MISTRAL_API_KEY=your_mistral_api_key
MISTRAL_AGENT_ID=your_mistral_agent_id   # optional

# -------- Email via Gmail MCP (AutoAuth) --------
# The Gmail AutoAuth MCP server is typically launched via: npx @gongrzhe/server-gmail-autoauth-mcp
GMAIL_MCP_COMMAND=npx
GMAIL_MCP_ARGS=@gongrzhe/server-gmail-autoauth-mcp

# -------- Azure (optional; used if sending emails via Azure Comm or other services) --------
AZURE_TENANT_ID=your_azure_tenant_id
AZURE_CLIENT_ID=your_azure_client_id
AZURE_CLIENT_SECRET=your_azure_client_secret
AZURE_COMMUNICATION_CONNECTION_STRING=endpoint=...;accesskey=...
AZURE_EMAIL_SENDER=no-reply@yourdomain.com

# -------- SharePoint / OneDrive (optional) --------
SHAREPOINT_HOST=your-tenant.sharepoint.com
SHAREPOINT_SITE_NAME=YourSiteName
SHAREPOINT_DRIVE_NAME=Documents
SHAREPOINT_FOLDER_PATH=/Shared Documents/AI

# -------- Resume / Files --------
RESUME_FOLDER_ID=drive_or_sharepoint_folder_id

# -------- Public Web Integrations (optional) --------
NEXT_PUBLIC_API_KEY=your_public_key_if_any
NEXT_PUBLIC_RAPID_API_HOST=example.p.rapidapi.com
NEXT_PUBLIC_RAPID_API_KEY=your_rapidapi_key
NEXT_PUBLIC_RAPID_API_URL=https://example.p.rapidapi.com

# -------- Exam / External Services (optional) --------
EXAM_BASE_URL=https://exam.example.com/api

# -------- Auth / JWT --------
JWT_SECRET=super_secret_jwt_key

# -------- Video / Avatar (optional) --------
HEYGEN_API_KEY=your_heygen_api_key

# -------- Security Notes --------
# - Keep `.env` out of version control (use .gitignore).
# - Rotate keys regularly.
# - In production, prefer a secrets manager (Vault, GCP Secret Manager, AWS Secrets Manager, Azure Key Vault).
