generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  email     String   @unique
  name      String?
  password  String
  role      Role     @default(USER)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  id        Int      @id @default(autoincrement())
}

model Candidate {
  name         String
  email        String     @unique
  status       String     @default("PENDING")
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  Avatar       String?
  Skills       String[]
  Voice        String?
  ph_number    BigInt?
  id           Int        @id @default(autoincrement())
  Exam_URL     String?
  tempPassword String?
  temp_name    String?    @unique
  College      String?
  Exam_date    DateTime?
  Expiry       DateTime?
  Interview    Interview?
  categories   Category[]
  resumeDetails ResumeDetails?
}

model Category {
  id           Int      @id @default(autoincrement())
  type         String
  candidateId  Int      
  createdAt    DateTime @default(now())

  candidate    Candidate @relation(fields: [candidateId], references: [id])
}

model ResumeDetails {
  id                Int        @id @default(autoincrement())
  candidateId       Int        @unique

  name              String?
  email             String?
  phone             String?
  skills            String[]

  UG_college        String?
  UG_cgpa           String?
  UG_yop            String?
  PG_college        String?
  PG_cgpa           String?
  PG_yop            String?

  projects          String[]
  certifications    String[]
  experience        String[]

  fileName          String?
  processedAt        DateTime   @default(now())
  
  candidate         Candidate   @relation(fields: [candidateId], references: [id])
}


model Question {
  id                String   @id @unique @default(uuid())
  question          String
  createdAt         DateTime
  constraints       String[]
  testcases         Json
  internalTestCases Json
  title             String?
}

model Interview {
  id                   String    @id @unique @default(uuid())
  candidate_id         Int       @unique
  interview_date       DateTime
  status               String
  Interviewscore       Int?
  Codingscore          Int?    
  Answers              String[]
  code                 String
  created_at           DateTime  @default(now())
  codeEvaluation       Json
  interview_start_time DateTime?
  questions            String?
  feedback             Feedback?
  candidate            Candidate @relation(fields: [candidate_id], references: [id])
}

model Feedback {
  id            String    @id @unique @default(uuid())
  interview_id  String    @unique
  ratings       Int       @default(0)
  provided_at   DateTime  @default(now())
  feedback_text Json
  interview     Interview @relation(fields: [interview_id], references: [id])
}

model JobDescription {
  id                        BigInt   @id @default(autoincrement())
  job_description           String
  role_category             String
  categorization_confidence Float
  categorization_reasoning  String
  key_indicators            Json
  total_candidates_evaluated Int
  created_at                DateTime @default(now())
  updated_at                DateTime @updatedAt
}

model CandidateScore {
  id               BigInt   @id @default(autoincrement())
  job_id           BigInt
  candidate_name   String
  resume_email     String?
  final_score      Float
  final_rank       Int
  detailed_reasoning String
  strengths        Json
  weaknesses       Json
  recommendation   String
  created_at       DateTime @default(now())
  updated_at       DateTime @updatedAt

}

model EmailAudit {
  id              BigInt   @id @default(autoincrement())
  sent_at         DateTime @default(now())
  job_id          BigInt?
  candidate_name  String?
  candidate_email String?
  email_type      String?
  subject         String?
  username        String?
  password        String?
  exam_link       String?
  send_status     String?
  raw_result      Json?
}


enum Role {
  USER
  ADMIN
  CANDIDATE
}
